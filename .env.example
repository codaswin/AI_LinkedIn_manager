# ==============================================================================
# AI LinkedIn Manager — environment variables (placeholders only, never commit
# real secrets; see CLAUDE.md's "Environment Variables" section)
# ==============================================================================

# --- Core infra ---------------------------------------------------------------
DATABASE_URL=postgresql://user:pass@localhost:5432/db
REDIS_URL=redis://localhost:6379/0
VECTOR_DB_PATH=./data/faiss_index

# --- Inference -------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PRIMARY=claude-sonnet-5
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5
HERMES_ENDPOINT=http://localhost:8001/v1        # self-hosted worker model, if used
HERMES_MODEL=hermes-3
LLM_COST_BUDGET_DAILY_USD=10
TRACE_SINK=local                                 # or langfuse/phoenix endpoint

# --- Composio (LinkedIn + optional X) ----------------------------------------
COMPOSIO_API_KEY=
COMPOSIO_LINKEDIN_CONNECTED_ACCOUNT_ID=
COMPOSIO_X_CONNECTED_ACCOUNT_ID=                 # only needed if the Research Agent's optional X source is used

LINKEDIN_API_RATE_LIMIT_CONNECTIONS_DAILY=5
LINKEDIN_API_RATE_LIMIT_REPLIES_DAILY=20
LINKEDIN_API_RATE_LIMIT_POSTS_DAILY=3
LINKEDIN_API_RATE_LIMIT_DELETES_DAILY=3
LINKEDIN_API_RATE_LIMIT_LIKES_DAILY=20

X_RESEARCH_POLL_INTERVAL_DEFAULT=daily           # seed value only — live value lives in the agent_settings DB table, editable via API/UI

# --- Research Agent: multi-source research (see PRPs / app/agents/research*.py) ---
# Hacker News requires no key.

# Reddit — https://www.reddit.com/prefs/apps (create a "script" app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ai-linkedin-manager-research-agent/1.0

# GitHub — optional; unauthenticated search works at a lower rate limit
GITHUB_TOKEN=

# Product Hunt — https://api.producthunt.com/v2/oauth/applications (v2, GraphQL)
PRODUCTHUNT_TOKEN=

# Web search — provider is swappable (see app/tools/web_search_provider.py).
# Default is DuckDuckGo (via the `ddgs` package) — no API key required.
# "none" disables the source gracefully (search_web returns zero results).
WEB_SEARCH_PROVIDER=duckduckgo                   # duckduckgo | brave | none
BRAVE_SEARCH_API_KEY=                            # only needed if WEB_SEARCH_PROVIDER=brave

# RSS — comma-separated feed URLs, no key required. Leave unset to use the
# built-in default list (TechCrunch, VentureBeat, HN Best/Newest, Y Combinator,
# MIT Tech Review, Google AI Blog, Hugging Face Blog — see
# app/tools/search_rss.py DEFAULT_RSS_FEEDS). Set this to replace that list.
RSS_FEEDS=

# --- Automation glue (optional) ----------------------------------------------
N8N_WEBHOOK_URL=http://localhost:5678/webhook/linkedin-poll

# --- Live LLM client (app/llmops/model_router.route_and_call) ---------------
# Token budgets per tier — override only if you change ANTHROPIC_MODEL_*/
# HERMES_MODEL to something with a meaningfully different real context window.
CONTEXT_BUDGET_PRIMARY_TOKENS=150000
CONTEXT_BUDGET_CHEAP_TOKENS=150000
CONTEXT_BUDGET_WORKER_TOKENS=24000

# Pricing — $ per 1,000 tokens. PLACEHOLDER DEFAULTS, not verified real
# provider pricing — override every one of these with your actual plan's
# real per-token price before trusting the $/day cost cap for anything real.
# Hermes has no defaults here since it's self-hosted (no per-token charge).
ANTHROPIC_PRICE_PRIMARY_IN_PER_1K=0.003
ANTHROPIC_PRICE_PRIMARY_OUT_PER_1K=0.015
ANTHROPIC_PRICE_CHEAP_IN_PER_1K=0.0008
ANTHROPIC_PRICE_CHEAP_OUT_PER_1K=0.004
HERMES_PRICE_IN_PER_1K=0
HERMES_PRICE_OUT_PER_1K=0

# --- Self-learning loop scheduler (app/learning/scheduler.py) ---------------
REFLECTION_JOB_INTERVAL_HOURS=168               # weekly by default (24 * 7)

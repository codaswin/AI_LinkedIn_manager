# Copy to deploy/production.env. The copied file is ignored by Git.
APP_DOMAIN=linkedin.example.com
ACME_EMAIL=admin@example.com
DASHBOARD_ADMIN_USERNAME=admin

SESSION_TTL_HOURS=12
DASHBOARD_LOGIN_MAX_ATTEMPTS=5
DASHBOARD_LOGIN_WINDOW_SECONDS=900

# Choose openai or anthropic after placing the matching key in deploy/secrets/.
# Leave empty while testing screens that do not invoke an LLM.
LLM_PROVIDER=
OPENAI_MODEL_PRIMARY=gpt-4o-mini
OPENAI_MODEL_CHEAP=gpt-4o-mini
ANTHROPIC_MODEL_PRIMARY=claude-sonnet-5
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5
LLM_COST_BUDGET_DAILY_USD=10
WEB_SEARCH_PROVIDER=duckduckgo

# Daily backups with fourteen-day local retention.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

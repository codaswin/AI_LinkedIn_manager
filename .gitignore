*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.service-account.json
*-service-account.json
service-account*.json
credentials.json
token.json
client_secret*.json
oauth*.json

# Local auth/token directories
.auth/
tokens/
credentials/
secrets/


